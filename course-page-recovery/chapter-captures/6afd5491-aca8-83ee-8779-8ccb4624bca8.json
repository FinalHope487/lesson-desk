RadioItem-eqbQKh\" tabindex=\"-1\" data-radix-collection-item=\"\"></button></div>A. A 的正常沸點通常較低</label></div><div class=\"RadioLabelWrapper-jyx5cL\" data-d-component=\"radio\"><label for=\"1-_r_ip_\" class=\"RadioLabel-aEyICO\" data-spacing=\"default\"><div class=\"RadioIndicatorWrapper-VjVXTu\"><button type=\"button\" role=\"radio\" aria-checked=\"false\" data-state=\"unchecked\" value=\"1\" id=\"1-_r_ip_\" class=\"RadioItem-eqbQKh\" tabindex=\"-1\" data-radix-collection-item=\"\"></button></div>B. A 的分子一定比 B 大</label></div><div class=\"RadioLabelWrapper-jyx5cL\" data-d-component=\"radio\"><label for=\"2-_r_ir_\" class=\"RadioLabel-aEyICO\" data-spacing=\"default\"><div class=\"RadioIndicatorWrapper-VjVXTu\"><button type=\"button\" role=\"radio\" aria-checked=\"false\" data-state=\"unchecked\" value=\"2\" id=\"2-_r_ir_\" class=\"RadioItem-eqbQKh\" tabindex=\"-1\" data-radix-collection-item=\"\"></button></div>C. A 的表面張力一定較大</label></div><div class=\"RadioLabelWrapper-jyx5cL\" data-d-component=\"radio\"><label for=\"3-_r_it_\" class=\"RadioLabel-aEyICO\" data-spacing=\"default\"><div class=\"RadioIndicatorWrapper-VjVXTu\"><button type=\"button\" role=\"radio\" aria-checked=\"false\" data-state=\"unchecked\" value=\"3\" id=\"3-_r_it_\" class=\"RadioItem-eqbQKh\" tabindex=\"-1\" data-radix-collection-item=\"\"></button></div>D. A 一定不具有分子間吸引力</label></div></div><button type=\"button\" class=\"Button-MckCnJ Button-MC8eGf\" data-color=\"secondary\" data-variant=\"outline\" data-pill=\"\" data-size=\"lg\" data-block=\"\" disabled=\"\" aria-disabled=\"true\" tabindex=\"-1\" data-disabled=\"\" data-d-component=\"button\" data-d-block=\"\"><span class=\"ButtonInner-okLAMd\">查看答案與解析</span></button></div><div class=\"Box-JYjgF4\" data-d-component=\"box\" data-d-direction=\"col\" data-d-has-border=\"\" style=\"border: 1px solid var(--color-border); border-radius: var(--dil-radius-lg); --w-box-gutter-block-end: calc(var(--spacing, 0.25rem) * 3); --w-box-gutter-block-start: calc